# Copy to ~/.config/anki-vocabulary/config.env; process environment overrides these.
# Paths may use ~ but not shell variables. No expansion/interpolation is performed.
VOCAB_DB_PATH=~/.local/share/anki-vocabulary/queue.sqlite3

# Must be a loopback HTTP URL. If absent, a private temporary server is started.
VOCAB_OLLAMA_URL=http://127.0.0.1:11434
VOCAB_OLLAMA_BINARY=ollama
VOCAB_OLLAMA_MODEL=qwen2.5:3b
VOCAB_OLLAMA_START_TIMEOUT=30
VOCAB_GENERATION_TIMEOUT=300
VOCAB_BATCH_SIZE=8

VOCAB_ANKI_URL=http://127.0.0.1:8765
# Set to the same key as AnkiConnect's apiKey when enabled.
# VOCAB_ANKI_API_KEY=your-local-key
VOCAB_ANKI_DECK=English Vocabulary
VOCAB_ANKI_NOTE_TYPE=Basic
VOCAB_ANKI_FRONT_FIELD=Front
VOCAB_ANKI_BACK_FIELD=Back
# Whitespace-separated tags.
VOCAB_ANKI_TAGS=english vocabulary
VOCAB_ANKI_SYNC=false
# Recommended: exact intended profile name. Startup add-on sets this automatically.
VOCAB_ANKI_PROFILE=User 1
VOCAB_ANKI_WAIT_TIMEOUT=30
VOCAB_MAX_ATTEMPTS=3
VOCAB_WORDNET=false
